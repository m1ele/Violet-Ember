#!/usr/bin/env bash
set -euo pipefail

VE_HOME="${VIOLET_EMBER_HOME:-$HOME/.config/violet-ember}"
ACCENTS_DIR="$VE_HOME/accents"
CURRENT="$VE_HOME/current-accent.conf"
BACKUP_DIR="$VE_HOME/backups"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

load_lib() {
  local name="$1"
  if [[ -f "$VE_HOME/lib/$name" ]]; then
    # shellcheck disable=SC1090
    source "$VE_HOME/lib/$name"
  elif [[ -f "$SCRIPT_DIR/../lib/$name" ]]; then
    # shellcheck disable=SC1090
    source "$SCRIPT_DIR/../lib/$name"
  fi
}

load_lib output.sh
load_lib system.sh
load_lib validator.sh
load_lib backup.sh
load_lib doctor.sh

# Fallback if output library is missing.
type ve_header >/dev/null 2>&1 || ve_header() { printf '\n◆ Violet Ember ◆\n\n'; }
type ve_info >/dev/null 2>&1 || ve_info() { printf '• %s\n' "$1"; }
type ve_success >/dev/null 2>&1 || ve_success() { printf '✔ %s\n' "$1"; }
type ve_warn >/dev/null 2>&1 || ve_warn() { printf '⚠ %s\n' "$1"; }
type ve_error >/dev/null 2>&1 || ve_error() { printf '✖ %s\n' "$1" >&2; }
type ve_section >/dev/null 2>&1 || ve_section() { printf '\n%s\n' "$1"; }
type ve_kv >/dev/null 2>&1 || ve_kv() { printf '%-14s %s\n' "$1" "$2"; }

usage() {
  ve_header
  cat <<'HELP'
Usage:
  violet-ember accent list
  violet-ember accent current
  violet-ember accent set <name>
  violet-ember doctor
  violet-ember backup list
  violet-ember backup create
  violet-ember help

Examples:
  violet-ember accent list
  violet-ember accent set ocean
  violet-ember doctor
HELP
}

require_home() {
  if [[ ! -d "$VE_HOME" ]]; then
    ve_error "Violet Ember is not installed for this user."
    ve_info "Run ./install.sh first."
    exit 1
  fi
}

current_accent() {
  require_home
  if [[ -f "$CURRENT" ]] && grep -q '^VE_ACCENT_NAME=' "$CURRENT"; then
    grep '^VE_ACCENT_NAME=' "$CURRENT" | head -n1 | cut -d= -f2- | tr -d '"'
  else
    echo "Unknown"
  fi
}

list_accents() {
  require_home
  local current name display marker file
  current="$(current_accent)"
  ve_header
  echo "Official Accent Packs"
  echo
  shopt -s nullglob
  for file in "$ACCENTS_DIR"/*.conf; do
    name="$(basename "$file" .conf)"
    display="$name"
    if grep -q '^VE_ACCENT_NAME=' "$file"; then
      display="$(grep '^VE_ACCENT_NAME=' "$file" | head -n1 | cut -d= -f2- | tr -d '"')"
    fi
    marker="•"
    [[ "$display" == "$current" ]] && marker="✔"
    printf '%s %s\n' "$marker" "$display"
  done
}

set_accent() {
  require_home
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    ve_error "Missing accent name."
    usage
    exit 1
  fi

  local src="$ACCENTS_DIR/${name}.conf"
  if [[ ! -f "$src" ]]; then
    ve_error "Accent not found: $name"
    list_accents
    exit 1
  fi

  if ! ve_validate_accent_file "$src"; then
    ve_error "Accent validation failed: $name"
    exit 1
  fi

  mkdir -p "$BACKUP_DIR"
  if [[ -f "$CURRENT" ]]; then
    cp "$CURRENT" "$BACKUP_DIR/current-accent.$(date +%Y%m%d-%H%M%S).conf"
    ve_success "Backup created"
  fi
  cp "$src" "$CURRENT"
  ve_success "Accent applied: $(current_accent)"
  ve_info "Run: source ~/.zshrc"
}

run_doctor() {
  require_home
  local ok=0 warn=0 fail=0 accent shell_name os_name terminal_name
  accent="$(current_accent)"
  shell_name="$(ve_shell_name 2>/dev/null || echo unknown)"
  os_name="$(ve_os_name 2>/dev/null || echo unknown)"
  terminal_name="$(ve_terminal_name 2>/dev/null || echo unknown)"

  ve_header
  echo "Running diagnostics..."

  ve_section "System"
  ve_kv "OS" "$os_name"
  ve_kv "Shell" "$shell_name"
  ve_kv "Terminal" "$terminal_name"

  ve_section "Checks"

  check_line() {
    local label="$1" fn="$2" optional="${3:-0}"
    if "$fn"; then
      ve_success "$label"
      ok=$((ok + 1))
    else
      if [[ "$optional" -eq 1 ]]; then
        ve_warn "$label"
        warn=$((warn + 1))
      else
        ve_error "$label"
        fail=$((fail + 1))
      fi
    fi
  }

  check_line "Zsh shell" ve_check_shell
  check_line "Config directory" ve_check_config_dir
  check_line "Theme file" ve_check_theme_file
  check_line "Current accent: $accent" ve_check_current_accent
  check_line "CLI installed" ve_check_cli
  check_line "Terminal 256 colors" ve_supports_256_colors 1
  check_line "Backup available" ve_has_backups 1
  check_line "Root theme installed" ve_check_root_theme 1

  ve_section "Summary"
  if [[ "$fail" -eq 0 ]]; then
    if [[ "$warn" -eq 0 ]]; then
      ve_success "System healthy"
    else
      ve_warn "System usable with $warn warning(s)"
    fi
  else
    ve_error "System has $fail issue(s)"
    exit 1
  fi
}

backup_list() {
  require_home
  ve_header
  echo "Available backups"
  echo
  if [[ ! -d "$BACKUP_DIR" ]] || ! find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 | grep -q .; then
    ve_warn "No backups found"
    return 0
  fi
  find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort | nl -w1 -s') '
}

backup_create() {
  require_home
  local target
  target="$(ve_create_named_backup)"
  ve_header
  ve_success "Backup created"
  ve_info "$target"
}

case "${1:-help}" in
  help|-h|--help) usage ;;
  doctor) run_doctor ;;
  accent)
    case "${2:-}" in
      list) list_accents ;;
      current) current_accent ;;
      set) set_accent "${3:-}" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  backup)
    case "${2:-}" in
      list) backup_list ;;
      create) backup_create ;;
      *) usage; exit 1 ;;
    esac
    ;;
  *) usage; exit 1 ;;
esac
