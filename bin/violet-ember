#!/usr/bin/env bash
set -euo pipefail

VE_PROJECT_ROOT="${VE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

source "${VE_PROJECT_ROOT}/lib/config.sh"
source "${VE_PROJECT_ROOT}/lib/output.sh"
source "${VE_PROJECT_ROOT}/lib/filesystem.sh"
source "${VE_PROJECT_ROOT}/lib/system.sh"
source "${VE_PROJECT_ROOT}/lib/accent.sh"
source "${VE_PROJECT_ROOT}/lib/backup.sh"
source "${VE_PROJECT_ROOT}/lib/doctor.sh"
source "${VE_PROJECT_ROOT}/lib/cli.sh"

source "${VE_PROJECT_ROOT}/commands/accent.sh"
source "${VE_PROJECT_ROOT}/commands/backup.sh"
source "${VE_PROJECT_ROOT}/commands/doctor.sh"
source "${VE_PROJECT_ROOT}/commands/restore.sh"

ve_dispatch "$@"
